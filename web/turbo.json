{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build-dev": {
      "dependsOn": ["^build"]
    },
    "bundle": {
      "env": ["TUNARR_VERSION", "TUNARR_BUILD", "TUNARR_EDGE_BUILD"],
      "inputs": ["$TURBO_DEFAULT$", ".env", "$TURBO_ROOT$/.env"],
      "dependsOn": ["^build", "extract-messages"],
      "outputs": ["dist/**"]
    },
    "clean-build": {
      "dependsOn": ["^build"]
    },
    "extract-messages": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "generate-client": {
      "dependsOn": ["@tunarr/server#generate-openapi"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": []
    }
  }
}
