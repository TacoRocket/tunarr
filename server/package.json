    "@types/uuid": "^9.0.8",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "catalog:vitest",
    "@yao-pkg/pkg": "^6.24.0",
    "cross-env": "^7.0.3",
    "del-cli": "^3.0.1",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.21.5",
    "esbuild-plugin-pino": "^2.3.3",
    "fast-check": "^4.2.0",
    "fast-glob": "^3.3.3",
    "kysely-ctl": "^0.9.0",
    "memfs": "^4.51.0",
    "node-abi": "^3.75.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.10",
    "tar": "^7.4.3",
    "thread-stream": "^3.1.0",
    "tmp": "^0.2.5",
    "tmp-promise": "^3.0.3",
    "ts-essentials": "^10.1.1",
