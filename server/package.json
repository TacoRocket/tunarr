    "tsx": "^4.20.5",
    "typed-emitter": "^2.1.0",
    "typescript": "catalog:",
    "unzipper": "^0.12.5",
    "vitest": "catalog:vitest"
  },
  "meilisearch": {
    "version": "1.52.4"
  },
  "ersatztvNext": {
    "releaseRepo": "TacoRocket/next",
    "releaseTag": "v0.2.4-trfork.10",
    "commit": "affa8b2c4fbb0cc97a7fdf93eabf17324f6b4b9f",
    "sha256": {
      "linux-x64": "1b4bfe4e4e868e744f825f54d5c632d0557d2ee6e1cdafb93f9b9fcd1a447c6a",
      "linux-musl-x64": "f40ca9bf20170f0a4e7e22dc11d012fecbcd6f6a5a608abc3077aa4a0ca158b4",
      "linux-arm64": "8c7f5e6cd6967ab50552839a775dded5c5dc71772118862f33795d4c047557bb",
      "macos-x64": "3216a73e02131a1da3ada13dd5ff508b6465efa30787a1d5c6d46b3e531a728b",
      "macos-arm64": "9faed9cbc71642ece78219adb0fa8e8c33fff1ef093e62a3fd093472d10ad67c",
      "windows-x64": "6e639daccb6793e733d3acc7c32053b516c2fccf573d2acf9e139d8a11125b75"
    },
    "note": "The fork's build of ErsatzTV next v0.2.4: upstream v0.2.4 plus a dropped live source being retried after one fallback, vaapi_low_power \"always\", continuous live http sources, and a VAAPI custom_shader drawn while scaling, optionally from a lower input height, with options for the faster CRT tiers, HDR10 and the NV12 handoff, a report of where each item falls back, and PGS burn-in that keeps pace on 4K and ends with the video. Schemas under src/stream/etv/schema are vendored from this commit. The server refuses a bundled worker whose version differs from releaseTag."
  }
