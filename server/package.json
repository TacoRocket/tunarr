{
  "name": "@tunarr/server",
  "version": "1.2.0-dev.1",
  "description": "Create LiveTV channels from your Plex media",
  "license": "Zlib",
  "private": true,
  "author": "chrisbenincasa",
  "type": "module",
  "main": "src/index.ts",
  "bin": "dist/bundle.cjs",
  "scripts": {
    "bench:worker-boundary": "cross-env NODE_ENV=development tsx scripts/worker-boundary-bench.ts",
    "test:bun": "bun tests/bun/run.ts",
    "bench:worker-pool": "cross-env NODE_ENV=development tsx scripts/worker-pool-ab.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json",
    "build-dev": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json --noEmit --watch",
    "bundle": "dotenvx run -- tsx scripts/bundle.ts",
    "clean": "rimraf --glob ./build/ ./dist/ ./bin/*",
    "debug": "cross-env NODE_ENV=development dotenvx run -f .env.development -- tsx watch --trace-warnings --tsconfig ./tsconfig.build.json --ignore 'src/streams' --inspect-wait ./src",
    "dev": "cross-env NODE_ENV=development dotenvx run -f .env.development -- tsx watch --heap-snapshot-on-oom --trace-warnings --tsconfig ./tsconfig.build.json --ignore 'build' --ignore 'src/streams' --ignore 'src/**/*.test.ts' ./src/index.ts",
    "download-ersatztv-next": "tsx scripts/download-ersatztv-next.ts",
    "generate-env": "tsx scripts/generateEnvModule.ts",
    "generate-etv-schemas": "tsx scripts/generate-etv-schemas.ts",
    "generate-openapi": "tsx src/index.ts generate-openapi",
    "install-meilisearch": "tsx scripts/download-meilisearch.ts",
    "kysely": "dotenv -e .env.development -- kysely",
    "lint": "oxlint src/ --report-unused-disable-directives --max-warnings 0",
    "make-bin": "dotenvx run -- tsx scripts/make-bin.ts",
    "predev": "tsx scripts/generateEnvModule.ts",
    "preinstall": "npx only-allow pnpm",
    "resolve-migrations": "tsx scripts/resolve-migrations.ts",
    "run-fixer": "dotenv -e .env.development -- tsx src/index.ts fixer",
    "test": "bun tests/bun/run.ts --node-fallback",
    "test:node": "vitest --typecheck.tsconfig tsconfig.test.json --run",
    "test:local": "vitest --config vitest.local.config.ts --typecheck.tsconfig tsconfig.test.json --run",
    "test:watch": "vitest --typecheck.tsconfig tsconfig.test.json --watch",
    "test:worker-smoke": "cross-env NODE_ENV=development tsx scripts/worker-smoke-test.ts",
    "tunarr": "dotenv -e .env.development -- tsx src/index.ts",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json --noEmit --diagnostics",
    "package-container": "dotenvx run -- tsx scripts/package-container.ts"
  },
  "dependencies": {
    "@cospired/i18n-iso-languages": "^4.2.0",
    "@dotenvx/dotenvx": "^1.49.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/error": "^4.2.0",
    "@fastify/multipart": "^9.0.3",
